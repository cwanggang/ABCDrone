# Copy this file to .env.local and fill in values. .env.local is git-ignored.
#
# IMPORTANT: every VITE_ variable is bundled into the JavaScript sent to the
# browser. Anyone using the site can read them. Never put secrets here that
# must stay secret (see README: "Security note").

# ---- Telemetry -------------------------------------------------------------
# Where drone data comes from: "mock" (simulated drones) or "thingspeak".
VITE_TELEMETRY_SOURCE=mock

# ---- Auth ------------------------------------------------------------------
# Skip login and act as a fake clinic user. Only works with `npm run dev`;
# production builds ignore it.
VITE_AUTH_BYPASS=true

# ---- Supabase (auth + drone list) -----------------------------------------
# From Supabase dashboard → Project Settings → API (or "Connect").
# The anon (public) key is designed to be shipped to browsers; row-level
# security in supabase/migrations decides what it can read.
# Never put the service_role / secret key here.
# Leave blank to run without Supabase (login won't work; use the bypass).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
